# Instalar como server em /etc/nginx/sites-available/estacao.
# Ajuste certificados existentes. Não configure root/alias apontando ao projeto.
server {
    listen 80;
    server_name meteo.eesjv.com.br;
    return 301 https://meteo.eesjv.com.br$request_uri;
}

server {
    listen 443 ssl;
    server_name meteo.eesjv.com.br;
    ssl_certificate /etc/letsencrypt/live/meteo.eesjv.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/meteo.eesjv.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 15s;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Inclui arquivos .env, .git, .aws e caminhos ocultos, em qualquer nível.
    location ~ /\. { return 404; }
    location ~* \.(?:db|sqlite3?|db-wal|db-shm|db-journal|sqlite3?-(?:wal|shm|journal)|bak|backup|pem|key|p12|pfx|log|py|pyc|ini|toml|ya?ml|sql|gz|zip|tar)(?:/|$) {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host meteo.eesjv.com.br;
        # Sobrescreve cabeçalhos enviados pelo cliente para evitar burla dos limites.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host meteo.eesjv.com.br;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
    }
}
