# Mesclar ao .env existente; não substituir as credenciais de radar/Evolution.
APP_ENV=production
PUBLIC_BASE_URL=https://meteo.eesjv.com.br
# Segredos aleatórios, distintos, com pelo menos 32 caracteres. Preservar os
# atuais se já forem fortes. Nunca colar valores reais em logs/chat/repositório.
SECRET_KEY=
WEBHOOK_SECRET=
# Hash bcrypt custo 12 a 16; remover completamente ADMIN_PASSWORD em texto.
ADMIN_PASSWORD_HASH=
SESSION_COOKIE_SECURE=true
HSTS_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
ADMIN_SESSION_ABSOLUTE_SECONDS=28800
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1
RATELIMIT_KEY_PREFIX=estacao
# Somente se o Gunicorn estiver em loopback atrás do Nginx fornecido.
TRUST_PROXY=true
TRUSTED_PROXY_IPS=127.0.0.1,::1
SIGNUP_CONFIRM_TOKEN_MAX_AGE_HOURS=24
UNSUBSCRIBE_TOKEN_MAX_AGE_DAYS=7
